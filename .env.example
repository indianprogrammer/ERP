# --- App DB (dedicated MariaDB instance) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=erp
DB_PASSWORD=erp_pass_2026
DB_NAME=erp

# --- Server ---
SESSION_SECRET=replace-with-a-long-random-string
HOST=0.0.0.0
PORT=3000

# --- API tokens (MCP server / external clients). Falls back to SESSION_SECRET. ---
JWT_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

# --- MCP stdio server (mcp/stdio.js) ---
# Defaults: ERP_API_URL=http://<connect-host>:<PORT> from this .env
# ERP_API_URL=http://localhost:3000
# ERP_TENANT=acme
# ERP_USERNAME=admin
# ERP_PASSWORD=changeme123

# --- Optional: GSTN / GSP (real integration) ---
GST_CLIENT_ID=
GST_CLIENT_SECRET=
GST_USERNAME=
GST_ASP_ID=
